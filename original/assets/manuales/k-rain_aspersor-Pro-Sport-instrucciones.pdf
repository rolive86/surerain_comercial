<script defer src="assets/site.js?v=20260607-ficha-fix"></script>
<script>
  // Pre-filtro via URL: catalogo.html?categoria=aspersores&marca=K-Rain (USA)&tipo=emergente
  (function () {
    const params = new URLSearchParams(window.location.search);
    const mappings = { mercado: 'vertical', categoria: 'category', marca: 'marca', tipo: 'tipo' };
    Object.keys(mappings).forEach(function (paramName) {
      const val = params.get(paramName);
      if (!val) return;
      const sel = document.querySelector('[data-filter-select="' + mappings[paramName] + '"]');
      if (sel) {
        sel.value = val;
        sel.dispatchEvent(new Event('change'));
      }
    });
  })();

  // Deep linking: si llega con ?producto=slug, abrir el modal de ese producto.
  // Espera a que site.js (defer) termine de cargar y el DOM esté listo.
  (function () {
    const slug = new URLSearchParams(window.location.search).get('producto');
    if (!slug) return;

    function intentarAbrir(intentos) {
      // Hasta ~6s de retry para casos lentos de carga
      if (intentos > 60) {
        console.warn('[catalogo] No se encontró el producto:', slug);
        return;
      }
      // Esperar a que site.js haya cargado sus funciones globales
      if (typeof window.slugify !== 'function' || typeof window.openProductModal !== 'function') {
        return setTimeout(function () { intentarAbrir(intentos + 1); }, 100);
      }
      var cards = document.querySelectorAll('.product-card');
      if (cards.length === 0) {
        return setTimeout(function () { intentarAbrir(intentos + 1); }, 100);
      }
      for (var i = 0; i < cards.length; i++) {
        var onclickAttr = cards[i].getAttribute('onclick') || '';
        var m = onclickAttr.match(/openProductModal\(\s*['"]([^'"]+)['"]/);
        if (m && window.slugify(m[1]) === slug) {
          try { cards[i].scrollIntoView({ behavior: 'auto', block: 'center' }); } catch (e) {}
          // Pequeño delay para que el scroll asiente antes del click
          setTimeout(function (card) { return function () { card.click(); }; }(cards[i]), 50);
          return;
        }
      }
      // Cards renderizadas pero no se encontró match: probablemente el slug no existe
      console.warn('[catalogo] Slug "' + slug + '" no coincide con ningún producto.');
    }

    // Arrancar cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { intentarAbrir(0); });
    } else {
      intentarAbrir(0);
    }
  })();
</script>
